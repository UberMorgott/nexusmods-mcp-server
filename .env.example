# Nexus Mods MCP Server configuration (copy to .env, or run: npm run setup)

# Personal API key: https://www.nexusmods.com/users/myaccount?tab=api
# Needed for v1 tools (mod info, files, downloads, tracking, endorsements) and v3 uploads.
# GraphQL tools (search, collections, users, news) work without it.
NEXUS_API_KEY=

# Optional default directory for download_file
NEXUS_DOWNLOAD_DIR=

# Optional: confine upload_file_version to files inside this directory
NEXUS_UPLOAD_DIR=

# Optional: 1 = show the web-tier browser window (debugging)
# NEXUS_BROWSER_VISIBLE=1
